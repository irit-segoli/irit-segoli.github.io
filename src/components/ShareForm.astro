---
const email = 'segoli@gmail.com';
---

<form
	action={`https://formsubmit.co/${email}`}
	method="POST"
	enctype="multipart/form-data"
	class="mt-6 flex flex-col gap-4"
>
	<input type="hidden" name="_subject" value="New submission — Irit Segoli archive" />
	<input type="hidden" name="_template" value="table" />
	<input type="hidden" name="_next" value={new URL('/thank-you', Astro.site).href} />
	<input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

	<div>
		<label for="name" class="block text-sm font-medium text-stone-700">Name</label>
		<input
			id="name"
			name="name"
			type="text"
			required
			class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none"
		/>
	</div>

	<div>
		<label for="email" class="block text-sm font-medium text-stone-700">Email</label>
		<input
			id="email"
			name="email"
			type="email"
			required
			class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none"
		/>
	</div>

	<div>
		<label for="message" class="block text-sm font-medium text-stone-700">
			What would you like to share?
		</label>
		<textarea
			id="message"
			name="message"
			rows="4"
			required
			placeholder="A description of the material, and/or a link to it if it's hosted elsewhere (Google Drive, Dropbox, etc.)"
			class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none"
		></textarea>
	</div>

	<div>
		<label for="attachment" class="block text-sm font-medium text-stone-700">
			Attach a file (optional, under 5MB — for larger files, share a link above instead)
		</label>
		<input
			id="attachment"
			name="attachment"
			type="file"
			accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
			class="mt-1 w-full text-sm text-stone-600"
		/>
	</div>

	<button
		type="submit"
		class="mt-2 inline-block self-start rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
	>
		Send
	</button>

	<p class="text-xs text-stone-400">
		Submissions are reviewed before anything is added to the archive.
	</p>
</form>
