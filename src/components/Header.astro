---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/articles', label: 'Articles' },
	{ href: '/exhibitions', label: 'Exhibitions' },
	{ href: '/justice', label: 'צדק / عدالة', dir: 'rtl' },
	{ href: '/more-articles', label: 'More Articles' },
];
---

<header class="border-b border-stone-200">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
		<a href="/" class="font-semibold tracking-tight text-stone-900">Irit Segoli</a>
		<ul class="flex gap-6 text-sm text-stone-600">
			{navLinks.map((link) => (
				<li>
					<a href={link.href} dir={link.dir} class="transition-colors hover:text-stone-900">{link.label}</a>
				</li>
			))}
		</ul>
	</nav>
</header>
