---
interface Props {
	id: string;
	title: string;
	year?: number;
	artists: string[];
	artistsLabel?: string;
	venue?: string;
	description?: string;
	invitation?: string;
	language: 'he' | 'en' | 'ar';
	pending: boolean;
	pendingNote?: string;
	hasPage: boolean;
}

const {
	id,
	title,
	year,
	artists,
	artistsLabel = artists.length > 1 ? 'אמנים' : 'אמן',
	venue,
	description,
	invitation,
	language,
	pending,
	pendingNote,
	hasPage,
} = Astro.props;
const dir = language === 'en' ? 'ltr' : 'rtl';
---

<li
	class:list={[
		'relative flex items-start gap-4 rounded-xl border p-4 transition-colors sm:p-5',
		pending ? 'border-dashed border-stone-300 bg-transparent' : 'border-stone-200 bg-white',
		hasPage && 'cursor-pointer hover:border-stone-300 hover:bg-stone-100/60',
	]}
>
	<span class="mt-0.5 h-14 w-14 shrink-0 overflow-hidden rounded-lg bg-stone-100">
		{invitation ? (
			<img src={invitation} alt="" class="h-full w-full object-cover" loading="lazy" />
		) : (
			<span class="flex h-full w-full items-center justify-center text-stone-400">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-6 w-6"
					aria-hidden="true"
				>
					<rect x="3" y="4" width="18" height="16" rx="1.5" />
					<circle cx="8.5" cy="9.5" r="1.5" />
					<path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.1 0L4 19" />
				</svg>
			</span>
		)}
	</span>

	<div class="min-w-0 flex-1">
		<div dir={dir} lang={language}>
			{year && <p class="text-sm font-medium tabular-nums text-stone-700">{year}</p>}
			{hasPage ? (
				<a
					href={`/exhibitions/${id}`}
					class:list={[
						'font-medium leading-snug after:absolute after:inset-0 after:rounded-xl hover:underline',
						pending ? 'text-stone-500' : 'text-stone-900',
					]}
				>
					{title}
				</a>
			) : (
				<span class="font-medium leading-snug text-stone-400">{title}</span>
			)}
			{artists.length > 0 && (
				<p class="mt-0.5 text-sm leading-snug text-stone-700">{artistsLabel}: {artists.join(', ')}</p>
			)}
			{venue && <p class="mt-0.5 text-sm leading-snug text-stone-500">{venue}</p>}
			{description && <p class="mt-1.5 text-sm leading-snug text-stone-600">{description}</p>}
		</div>

		{pending && pendingNote && <p class:list={['mt-1 text-sm italic leading-snug text-stone-400', dir === 'rtl' && 'text-right']} dir="ltr" lang="en">{pendingNote}</p>}

		{pending && (
			<p class="mt-1.5 text-[11px] uppercase tracking-wide text-stone-400" dir={dir}>
				Materials pending
			</p>
		)}
	</div>
</li>
