---
import { getCollection, getEntries, render } from 'astro:content';
import ExhibitionLayout from '../../layouts/ExhibitionLayout.astro';
import { hasExhibitionPage } from '../../lib/exhibitions';

export async function getStaticPaths() {
	const exhibitions = await getCollection(
		'exhibitions',
		({ data }) => !data.draft && hasExhibitionPage(data),
	);
	return exhibitions.map((exhibition) => ({
		params: { id: exhibition.id },
		props: { exhibition },
	}));
}

const { exhibition } = Astro.props;
const { data } = exhibition;
const { Content } = data.hasCuratorialText ? await render(exhibition) : { Content: null };
const relatedArticles = (await getEntries(data.relatedArticles)).filter((article) => !article.data.draft);
---

<ExhibitionLayout
	title={data.title}
	year={data.year}
	language={data.language}
	venue={data.venue}
	curators={data.curators}
	artists={data.artists}
	invitation={data.invitation}
	catalogPdf={data.catalogPdf}
	catalogPdfEn={data.catalogPdfEn}
	installationImages={data.installationImages}
	reviews={data.reviews}
	relatedArticles={relatedArticles}
>
	{data.hasCuratorialText && <Content />}
</ExhibitionLayout>
