---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you">
	<div class="mx-auto max-w-2xl px-6 py-16">
		<h1 class="text-3xl font-semibold tracking-tight text-stone-900">Thank you</h1>
		<p class="mt-4 text-stone-600">
			Your submission has been received. It will be reviewed before anything is added to the
			archive.
		</p>
		<a href="/" class="mt-8 inline-block text-sm text-stone-500 transition-colors hover:text-stone-900">
			&larr; Back to home
		</a>
	</div>
</BaseLayout>
