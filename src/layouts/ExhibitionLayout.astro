---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleListItem from '../components/ArticleListItem.astro';

type Review = CollectionEntry<'exhibitions'>['data']['reviews'][number];

interface Props {
	title: string;
	year?: number;
	language: 'he' | 'en' | 'ar';
	venue?: string;
	curators: string[];
	artists: string[];
	invitation?: string;
	catalogPdf?: string;
	catalogPdfEn?: string;
	installationImages: string[];
	reviews: Review[];
	relatedArticles: CollectionEntry<'articles'>[];
}

const {
	title,
	year,
	language,
	venue,
	curators,
	artists,
	invitation,
	catalogPdf,
	catalogPdfEn,
	installationImages,
	reviews,
	relatedArticles,
} = Astro.props;
const dir = language === 'en' ? 'ltr' : 'rtl';
---

<BaseLayout title={title}>
	<article class="mx-auto max-w-2xl px-6 py-16">
		<a href="/exhibitions" class="text-sm text-stone-500 transition-colors hover:text-stone-900">&larr; All exhibitions</a>

		<h1 class="mt-6 text-3xl font-semibold tracking-tight text-stone-900">{title}</h1>

		<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-stone-500">
			<span>{year}</span>
			{venue && <span>&middot; {venue}</span>}
			{curators.length > 0 && <span>&middot; curated by {curators.join(', ')}</span>}
		</div>

		{artists.length > 0 && (
			<p class="mt-2 text-sm text-stone-500">Artists: {artists.join(', ')}</p>
		)}

		{invitation && (
			<img src={invitation} alt={`Exhibition invitation: ${title}`} class="mt-8 rounded-lg border border-stone-200" />
		)}

		<div class="prose prose-stone mt-10 max-w-none">
			<slot />
		</div>

		{installationImages.length > 0 && (
			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				{installationImages.map((src) => (
					<img src={src} alt={`Installation view: ${title}`} class="rounded-lg border border-stone-200" />
				))}
			</div>
		)}

		{(catalogPdf || catalogPdfEn) && (
			<div class="mt-10 flex flex-wrap gap-3">
				{catalogPdf && (
					<a
						href={catalogPdf}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
					>
						{catalogPdfEn ? 'Download catalog (Hebrew)' : 'Download catalog'}
					</a>
				)}
				{catalogPdfEn && (
					<a
						href={catalogPdfEn}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
					>
						Download catalog (English)
					</a>
				)}
			</div>
		)}

		{reviews.length > 0 && (
			<section class="mt-12 border-t border-stone-200 pt-8">
				<h2 class="text-lg font-semibold tracking-tight text-stone-900">Reviews</h2>
				<ul class="mt-4 space-y-4">
					{reviews.map((review) => {
						const link = review.pdf ?? review.url;
						return (
							<li class="text-sm leading-relaxed">
								<p class="text-stone-700" dir={dir} lang={language}>
									{review.author},{' '}
									{link ? (
										<a href={link} target="_blank" rel="noopener noreferrer" class="underline hover:text-stone-900">
											&quot;{review.title}&quot;
										</a>
									) : (
										<>&quot;{review.title}&quot;</>
									)}
									, {review.publication}
									{review.issue && `, ${review.issue}`}
									{review.date && `, ${review.date}`}
								</p>
								{!review.found && <p class="mt-0.5 text-xs italic text-stone-400">Copy not yet located</p>}
							</li>
						);
					})}
				</ul>
			</section>
		)}

		{relatedArticles.length > 0 && (
			<section class="mt-12 border-t border-stone-200 pt-8">
				<h2 class="text-lg font-semibold tracking-tight text-stone-900">Related articles</h2>
				<ul class="mt-4 space-y-3">
					{relatedArticles.map((article) => (
						<ArticleListItem
							id={article.id}
							title={article.data.title}
							year={article.data.year}
							publication={article.data.publication}
							language={article.data.language}
							hasFullText={article.data.hasFullText}
							pdf={article.data.pdf}
							externalUrl={article.data.externalUrl}
							thumbnail={article.data.thumbnail}
							pending={article.data.pending}
							pendingNote={article.data.pendingNote}
						/>
					))}
				</ul>
			</section>
		)}
	</article>
</BaseLayout>
