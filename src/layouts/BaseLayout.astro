---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	// Starts in English with the Hebrew name embedded mid-sentence: a description that opens in Hebrew
	// gets rendered right-to-left in Google results, which scrambles the punctuation around it
	description = 'Irit Segoli (אירית סגולי) is an art researcher, curator, and justice activist. An archive of her articles, catalog essays, and exhibitions.',
} = Astro.props;

const siteName = 'Irit Segoli | אירית סגולי';
const pageTitle = title === 'Home' ? siteName : `${title} · ${siteName}`;
// build.format 'file' puts .html in the pathname; canonical URLs use the clean form the site links to
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);

// Tells search engines the site is about this person, under both spellings of her name
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Irit Segoli',
	alternateName: ['אירית סגולי', 'Irit Segoly'],
	description: 'Art researcher, curator, and justice activist',
	jobTitle: ['Art researcher', 'Curator'],
	url: Astro.site?.href,
};

// Google takes the site name shown above results from WebSite data on the homepage;
// without it, a github.io site is labelled "GitHub"
const isHome = title === 'Home';
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Irit Segoli',
	alternateName: ['אירית סגולי', 'Irit Segoli Archive'],
	url: Astro.site?.href,
};
---

<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content="Irit Segoli (אירית סגולי)" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="he_IL" />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		{isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
		<title>{pageTitle}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-stone-50 text-stone-900">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
